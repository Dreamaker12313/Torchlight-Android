 #include "OgreGLNativeSupport.h"
 
 #include "OgreGLSLESProgram.h"
+
+#include <chrono>
+
+// Torchlight (patches/ogre/0023): shader compiles and links on the calling
+// thread, in nanoseconds, since the game last read them.
+extern "C" {
+struct ogre_gles2_shader_stats_t
+{
+    unsigned long long compile_ns, link_ns, worst_compile_ns, worst_link_ns;
+    unsigned compiles, links;
+};
+struct ogre_gles2_shader_stats_t ogre_gles2_shader_stats;
+}
+
+namespace Ogre {
+    static unsigned long long shaderTimerNow()
+    {
+        return static_cast<unsigned long long>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count());
+    }
+
+    GLSLESShaderTimer::GLSLESShaderTimer(bool link) : mLink(link), mStarted(shaderTimerNow()) {}
+
+    GLSLESShaderTimer::~GLSLESShaderTimer()
+    {
+        const unsigned long long ns = shaderTimerNow() - mStarted;
+        ogre_gles2_shader_stats_t& s = ogre_gles2_shader_stats;
+        if (mLink)
+        {
+            s.link_ns += ns;
+            s.links++;
+            if (ns > s.worst_link_ns) s.worst_link_ns = ns;
+        }
+        else
+        {
+            s.compile_ns += ns;
+            s.compiles++;
+            if (ns > s.worst_compile_ns) s.worst_compile_ns = ns;
+        }
+    }
+}
