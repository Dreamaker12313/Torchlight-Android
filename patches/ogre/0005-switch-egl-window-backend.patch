diff --git a/RenderSystems/GLSupport/include/EGL/Switch/OgreSwitchEGLSupport.h b/RenderSystems/GLSupport/include/EGL/Switch/OgreSwitchEGLSupport.h
new file mode 100644
index 000000000..0d30d9d5f
--- /dev/null
+++ b/RenderSystems/GLSupport/include/EGL/Switch/OgreSwitchEGLSupport.h
@@ -0,0 +1,25 @@
+// Nintendo Switch EGL support for OGRE, added by the Torchlight Switch port.
+// Models the Android backend: one fullscreen native window owned by the OS,
+// no window manager, EGL_DEFAULT_DISPLAY.
+#ifndef __SwitchEGLSupport_H__
+#define __SwitchEGLSupport_H__
+
+#include "OgreEGLSupport.h"
+
+namespace Ogre {
+    class _OgrePrivate SwitchEGLSupport : public EGLSupport
+    {
+    public:
+        // The profile the render system asked for: CONTEXT_ES for GLES2,
+        // CONTEXT_CORE for GL3Plus (switch-mesa offers desktop GL 4.3 too).
+        explicit SwitchEGLSupport(int profile);
+        virtual ~SwitchEGLSupport();
+
+        RenderWindow* newWindow(const String& name,
+                                unsigned int width, unsigned int height,
+                                bool fullScreen,
+                                const NameValuePairList* miscParams = 0) override;
+    };
+}
+
+#endif
