+        /** Torchlight: the skeleton's pose for the frame about to be drawn, worked out now
+            (cacheBoneMatrices). For a pass over skinned entities on worker threads before the
+            frame: it touches only this entity's skeleton instance and the tag points on it, and
+            the frame's own updateAnimation then finds the bones current and does not repeat it.
+        */
+        bool _cacheBoneMatricesForFrame(void) { return cacheBoneMatrices(); }
+
+        /// Torchlight: whether an animation state changed since the pose was last worked out.
+        bool _isAnimationDirty(void) const;
