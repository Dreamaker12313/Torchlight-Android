+// Flush the frame and queue its back buffer for display. On glthread's
+// worker when it runs (switch_swap_job), after everything the frame queued;
+// on the application's thread otherwise.
+static void
+switch_present(struct switch_egl_surface *surface, struct switch_egl_context *context)
+{
     if (surface->cur_slot < 0) {
         TRACE("Nothing to do\n");
-        return EGL_TRUE;
-    }
-
-    // Everything the frame queued has to reach the pipe context before this
-    // thread flushes it and reads the back buffer's fence.
-    if (context->stctx->thread_finish)
-        context->stctx->thread_finish(context->stctx);
+        return;
+    }
 
     TRACE("Flushing context\n");
     context->stctx->flush(context->stctx, ST_FLUSH_END_OF_FRAME, NULL, NULL, NULL);
@@ -771,6 +776,37 @@
     surface->attachments[ST_ATTACHMENT_BACK_LEFT] = NULL;
     surface->attachments[ST_ATTACHMENT_FRONT_LEFT] = old_back;
     p_atomic_inc(&surface->stfbi->stamp);
+}
+
+static void
+switch_swap_job(void *data, int thread_index)
+{
+    (void)thread_index;
+    struct switch_egl_surface *surface = (struct switch_egl_surface *) data;
+    switch_present(surface, surface->swap_context);
+}
+
+static EGLBoolean
+switch_swap_buffers(_EGLDriver *drv, _EGLDisplay *dpy, _EGLSurface *surf)
+{
+    CALLED();
+    struct switch_egl_surface* surface = switch_egl_surface(surf);
+    struct switch_egl_context* context = switch_egl_context(surface->base.CurrentContext);
+
+    // With glthread the swap is queued after the frame's commands and runs on
+    // the worker, so the application's thread goes on to the next frame
+    // instead of waiting for the worker to finish this one: on the console the
+    // game's thread spent a tenth of a town frame in that wait. One swap in
+    // flight at a time, which keeps the application at most a frame ahead.
+    util_queue_fence_wait(&surface->swap_fence);
+    surface->swap_context = context;
+    if (context->stctx->thread_call &&
+        context->stctx->thread_call(context->stctx, switch_swap_job, surface, &surface->swap_fence))
+        return EGL_TRUE;
+
+    // Without glthread: everything the frame queued has reached the pipe
+    // context already.
+    switch_present(surface, context);
     return EGL_TRUE;
 }
 
