+#ifdef __SWITCH__
+static bool
+st_thread_call(struct st_context_iface *stctxi,
+               void (*fn)(void *data, int thread_index),
+               void *data, struct util_queue_fence *fence)
+{
+   struct st_context *st = (struct st_context *) stctxi;
+   struct glthread_state *glthread = &st->ctx->GLThread;
+
+   if (!glthread->enabled)
+      return false;
+
+   /* What was recorded so far goes first; the queue runs jobs in order on
+    * its one thread. */
+   _mesa_glthread_flush_batch(st->ctx);
+   util_queue_add_job(&glthread->queue, data, fence, fn, NULL, 0);
+   glthread->call_fence = fence;
+   return true;
+}
+#endif
