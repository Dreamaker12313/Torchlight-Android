+#ifdef __SWITCH__
+/* glBufferData and glBufferSubData copy their data into the command, and a
+ * command must fit in one 8 KiB batch, so any larger upload used to wait for
+ * the worker to finish everything queued and then ran on the application's
+ * thread: a game streaming its dynamic vertex buffers (particles,
+ * billboards, software-skinned meshes, every one of them over 8 KiB) paid a
+ * full synchronisation for each. An upload up to this size is copied to the
+ * heap instead and the command carries the copy, which the worker frees
+ * once it has made the call. The data is still copied at the call, as GL
+ * requires; only the wait is gone. */
+#define SWITCH_HEAP_UPLOAD_MAX (32 * 1024 * 1024)
+#endif
 
