 void
 _mesa_glthread_finish_before(struct gl_context *ctx, const char *func)
 {
+#ifdef __SWITCH__
+   const int64_t started = os_time_get_nano();
+#endif
    _mesa_glthread_finish(ctx);
+#ifdef __SWITCH__
+   struct mesa_switch_glthread_stats *stats = &mesa_switch_glthread_stats;
+   stats->sync_ns += (uint64_t)(os_time_get_nano() - started);
+   stats->syncs++;
+   /* By name: the names are string literals, one address each. */
+   for (unsigned i = 0; i < MESA_SWITCH_GLTHREAD_FUNCS; i++) {
+      if (stats->by_func[i].func == func || stats->by_func[i].func == NULL) {
+         stats->by_func[i].func = func;
+         stats->by_func[i].count++;
+         break;
+      }
+   }
+#endif
 
    /* Uncomment this if you want to know where glthread syncs. */
    /*printf("fallback to sync: %s\n", func);*/
diff --git a/src/mesa/main/glthread.h b/src/mesa/main/glthread.h
--- a/src/mesa/main/glthread.h
+++ b/src/mesa/main/glthread.h
@@ -122,6 +122,29 @@
 void _mesa_glthread_disable(struct gl_context *ctx, const char *func);
 void _mesa_glthread_flush_batch(struct gl_context *ctx);
 void _mesa_glthread_finish(struct gl_context *ctx);
+
+#ifdef __SWITCH__
+/* What glthread cost the application's own thread, for a game's log: the
+ * time it spent synchronised with the worker (every fallback to a
+ * synchronous call goes through _mesa_glthread_finish_before, which also
+ * executes the pending batch on this thread), the time it spent blocked
+ * handing a batch to a full queue (the worker is the slower of the two), and
+ * the large buffer uploads queued as a heap copy instead of a sync. Only the
+ * application's thread writes it; the game reads it between frames. */
+#define MESA_SWITCH_GLTHREAD_FUNCS 16
+struct mesa_switch_glthread_stats {
+   uint64_t sync_ns;
+   uint64_t full_ns;
+   uint64_t heap_bytes;
+   uint32_t syncs;
+   uint32_t heap_uploads;
+   struct {
+      const char *func;
+      uint32_t count;
+   } by_func[MESA_SWITCH_GLTHREAD_FUNCS];
+};
+extern struct mesa_switch_glthread_stats mesa_switch_glthread_stats;
+#endif
 void _mesa_glthread_finish_before(struct gl_context *ctx, const char *func);
 
 void _mesa_glthread_BindBuffer(struct gl_context *ctx, GLenum target,
