+/*
+-----------------------------------------------------------------------------------------------
+Torchlight's ribbon trail.
+
+Torchlight links its own build of OGRE 1.6.5 (`game/lib64/libOgreMain-1.6.5.so` in the Linux
+release), and Runic changed that build's `Ogre::RibbonTrail`: a flipbook frame per chain, a start
+and an end colour for the two ends, texture coordinates stretched over the whole trail, and a
+"beam" mode that lays the chain out along a line with a sine displacement. Torchlight's
+`ParticleUniverse::RibbonTrailRenderer` drives those additions every frame, so a ribbon drawn with
+OGRE 14's stock trail would be neither Torchlight's shape nor its colour.
+
+OGRE 14's RibbonTrail keeps its members private and `updateTrail` non-virtual, so this is a class
+of its own: OGRE's RibbonTrail (MIT) with Runic's changes transcribed from the library. Addresses
+are the library's own (`libOgreMain-1.6.5.so`, loaded at 0), not `Torchlight.bin.x86_64`'s.
+-----------------------------------------------------------------------------------------------
+*/
+
+#ifndef __PU_TORCHLIGHT_RIBBON_TRAIL_H__
+#define __PU_TORCHLIGHT_RIBBON_TRAIL_H__
+
+#include "ParticleUniversePrerequisites.h"
+#include "OgreBillboardChain.h"
+#include "OgreController.h"
+#include "OgreNode.h"
+
+namespace ParticleUniverse
+{
+	class _ParticleUniverseExport TorchlightRibbonTrail : public Ogre::BillboardChain, public Ogre::Node::Listener
+	{
+		public:
+			TorchlightRibbonTrail(const String& name, size_t maxElements = 20, size_t numberOfChains = 1,
+				bool useTextureCoords = true, bool useVertexColours = true);
+			virtual ~TorchlightRibbonTrail(void);
+
+			void addNode(Ogre::Node* n);
+			void removeNode(const Ogre::Node* n);
+			size_t getChainIndexForNode(const Ogre::Node* n);
+
+			void setTrailLength(Real len);
+			Real getTrailLength(void) const {return mTrailLength;}
+			virtual void setMaxChainElements(size_t maxElements) override;
+			virtual void setNumberOfChains(size_t numChains) override;
+			virtual void clearChain(size_t chainIndex) override;
+
+			void setInitialColour(size_t chainIndex, const ColourValue& col);
+			void setInitialColour(size_t chainIndex, float r, float g, float b, float a = 1.0f);
+			void setColourChange(size_t chainIndex, const ColourValue& valuePerSecond);
+			void setColourChange(size_t chainIndex, float r, float g, float b, float a);
+			void setInitialWidth(size_t chainIndex, Real width);
+			void setWidthChange(size_t chainIndex, Real widthDeltaPerSecond);
+
+			/** Runic: the flipbook the chains share and the frame one chain shows
+				(`Ogre::RibbonTrail::setFrame` 0x26bca0).
+			*/
+			void setFrame(unsigned int chainIndex, int flipbookWidth, int flipbookHeight, int frame);
+
+			/** Runic: what the head and the tail element are tinted by
+				(`Ogre::RibbonTrail::setStartEndColors` 0x268f40).
+			*/
+			void setStartEndColors(const ColourValue& start, const ColourValue& end);
+
+			/** Runic: lay the chains out along a line to `end` with a sine displacement
+				(`Ogre::RibbonTrail::updateTrailBeam` 0x2690c0), or not.
+			*/
+			void updateTrailBeam(bool beam, const Vector3& end, Real sineAngle, const Vector3& force,
+				Real frequencyMin, Real frequencyMax);
+
+			virtual void nodeUpdated(const Ogre::Node* node) override;
+			virtual void nodeDestroyed(const Ogre::Node* node) override;
+
+			/** Fading and width change, a frame at a time. */
+			void _timeUpdate(Real time);
+
+			virtual const String& getMovableType(void) const override;
+
+		protected:
+			typedef vector<Ogre::Node*> NodeList;
+			typedef vector<size_t> IndexVector;
+			typedef map<const Ogre::Node*, size_t> NodeToChainSegmentMap;
+			typedef vector<ColourValue> ColourValueList;
+			typedef vector<Real> RealList;
+
+			NodeList mNodeList;
+			IndexVector mNodeToChainSegment;
+			IndexVector mFreeChains;
+			NodeToChainSegmentMap mNodeToSegMap;
+
+			/* Runic's fields, with their offsets in its RibbonTrail. */
+			bool mBeam;                         // +0x290
+			Real mBeamSineAngle;                // +0x294
+			Real mBeamFrequencyMin;             // +0x298
+			Real mBeamFrequencyMax;             // +0x29c
+			int mFlipbookWidth;                 // +0x2a0
+			int mFlipbookHeight;                // +0x2a4
+			Vector3 mBeamForce;                 // +0x2a8
+			Vector3 mBeamEnd;                   // +0x2b4
+			ColourValue mStartColour;           // +0x2c0
+			ColourValue mEndColour;             // +0x2d0
+
+			Real mTrailLength;                  // +0x2e0
+			Real mElemLength;                   // +0x2e4
+			Real mSquaredElemLength;            // +0x2e8
+			ColourValueList mInitialColour;     // +0x2f0
+			ColourValueList mDeltaColour;       // +0x308
+			vector<int> mFrames;                // +0x320, Runic: one frame per chain
+			RealList mInitialWidth;             // +0x338
+			RealList mDeltaWidth;               // +0x350
+			Ogre::ControllerFloat* mFadeController;
+			Ogre::ControllerValueRealPtr mTimeControllerValue;
+
+			void manageController(void);
+			void updateTrail(size_t index, const Ogre::Node* node);
+			void resetTrail(size_t index, const Ogre::Node* node);
+			void resetAllTrails(void);
+	};
+
+	/** Creates TorchlightRibbonTrails for a scene manager, so the trail has one (its lights and
+		its destruction go through it), as OGRE's own trails do.
+	*/
+	class _ParticleUniverseExport TorchlightRibbonTrailFactory : public Ogre::MovableObjectFactory
+	{
+		public:
+			static const String FACTORY_TYPE_NAME;
+			virtual const String& getType(void) const override {return FACTORY_TYPE_NAME;}
+
+		private:
+			virtual Ogre::MovableObject* createInstanceImpl(const String& name,
+				const Ogre::NameValuePairList* params) override;
+	};
+}
+
+#endif
