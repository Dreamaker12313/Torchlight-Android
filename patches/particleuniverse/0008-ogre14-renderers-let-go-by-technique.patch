 	//-----------------------------------------------------------------------
 	LightRenderer::~LightRenderer(void)
 	{
+#if OGRE_VERSION >= 0xE0000
+		// Torchlight's technique clears the parent before destroying its renderer
+		// (`ParticleTechnique::destroyRenderer`); the technique this renderer was prepared
+		// for is the one destroying it, so it is still there to tear down with. The game uses no
+		// light renderer; this only keeps the library's working with the fork's technique.
+		if (!mParentTechnique)
+			mParentTechnique = mPreparedTechnique;
+#endif
 		if (!mParentTechnique)
 			return;
 		
