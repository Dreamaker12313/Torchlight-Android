+	//-----------------------------------------------------------------------
+	// Torchlight: `ParticleSystemManager::setMaxNumberOfParticles`. Only the
+	// difference is created or deleted, and deleting takes only what the store still holds.
+	void ParticleSystemManager::setMaxNumberOfParticles(unsigned int maxNumberOfParticles)
+	{
+		if (mMaxNumberOfParticles == maxNumberOfParticles)
+			return;
+
+		int difference = (int)maxNumberOfParticles - (int)mMaxNumberOfParticles;
+		mMaxNumberOfParticles = maxNumberOfParticles;
+		if (difference > 0)
+		{
+			for (int i = 0; i < difference; ++i)
+			{
+				mVisualParticleStore.push_back(PU_NEW_T(VisualParticle, MEMCATEGORY_SCENE_OBJECTS)());
+			}
+		}
+		else
+		{
+			for (int i = 0; i < -difference; ++i)
+			{
+				if (mVisualParticleStore.empty())
+					continue;
+				VisualParticle* particle = mVisualParticleStore.back();
+				mVisualParticleStore.pop_back();
+				if (particle)
+				{
+					PU_DELETE_T(particle, VisualParticle, MEMCATEGORY_SCENE_OBJECTS);
+				}
+			}
+		}
+	}
+	//-----------------------------------------------------------------------
+	// Torchlight: `ParticleSystemManager::_FillPoolOfParticles`. Taken from the
+	// back of the store.
+	void ParticleSystemManager::_FillPoolOfParticles(vector<VisualParticle*>& particles, Pool<VisualParticle>& pool,
+		Particle::ParticleBehaviourList& behaviours, unsigned int count)
+	{
+		while (count != 0 && !mVisualParticleStore.empty())
+		{
+			VisualParticle* particle = mVisualParticleStore.back();
+			mVisualParticleStore.pop_back();
+			particle->copyBehaviours(behaviours);
+			pool.addElement(particle);
+			particles.push_back(particle);
+			--count;
+		}
+	}
+	//-----------------------------------------------------------------------
+	// Torchlight: `ParticleSystemManager::_FreePoolOfParticles`. Each particle's
+	// visual data is dropped as it goes back.
+	void ParticleSystemManager::_FreePoolOfParticles(vector<VisualParticle*>& particles)
+	{
+		for (size_t i = 0; i < particles.size(); ++i)
+		{
+			particles[i]->visualData = 0;
+			mVisualParticleStore.push_back(particles[i]);
+		}
+		particles.clear();
