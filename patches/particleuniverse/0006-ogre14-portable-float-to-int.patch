diff --git a/Plugins/ParticleUniverse/include/ParticleUniverseFloatConvert.h b/Plugins/ParticleUniverse/include/ParticleUniverseFloatConvert.h
new file mode 100644
index 0000000..2ad50c0
--- /dev/null
+++ b/Plugins/ParticleUniverse/include/ParticleUniverseFloatConvert.h
@@ -0,0 +1,63 @@
+/*
+-----------------------------------------------------------------------------------------------
+Float to integer as the x86-64 reference build converts it, on every CPU.
+
+Not part of the OGRECave library: added by the Torchlight port (patches/particleuniverse/). A C++
+cast from a float the integer type cannot hold (NaN, an infinity, too large, or anything negative
+for an unsigned type) is undefined, and the two CPUs the port runs on answer differently:
+x86-64's `cvttss2si`/`cvttsd2si` give the type's minimum (the "integer indefinite"), and GCC
+reaches a 32-bit unsigned through the 64-bit signed conversion and keeps the low half, while
+AArch64 (the Switch) saturates, and gives 0 for NaN. `Torchlight.bin.x86_64` is the reference, so
+these give x86-64's answer everywhere; in range they are the plain cast. The same conversions as
+the engine's `src/formats/float_convert.h`, which the library cannot include.
+-----------------------------------------------------------------------------------------------
+*/
+
+#ifndef __PU_FLOAT_CONVERT_H__
+#define __PU_FLOAT_CONVERT_H__
+
+#include <stdint.h>
+#include <limits>
+
+namespace ParticleUniverse
+{
+	/** `cvttss2si` to 32 bits: `(int)float`. */
+	inline int32_t x86FloatToInt32(float v)
+	{
+		if (!(v >= -2147483648.0f && v < 2147483648.0f))
+			return std::numeric_limits<int32_t>::min();
+		return static_cast<int32_t>(v);
+	}
+
+	/** `cvttsd2si` to 32 bits: `(int)double`. */
+	inline int32_t x86DoubleToInt32(double v)
+	{
+		if (!(v > -2147483649.0 && v < 2147483648.0))
+			return std::numeric_limits<int32_t>::min();
+		return static_cast<int32_t>(v);
+	}
+
+	/** `cvttss2si` to 64 bits: `(long)float` on LP64. */
+	inline int64_t x86FloatToInt64(float v)
+	{
+		if (!(v >= -9223372036854775808.0f && v < 9223372036854775808.0f))
+			return std::numeric_limits<int64_t>::min();
+		return static_cast<int64_t>(v);
+	}
+
+	/** `cvttsd2si` to 64 bits: `(long)double` on LP64. */
+	inline int64_t x86DoubleToInt64(double v)
+	{
+		if (!(v >= -9223372036854775808.0 && v < 9223372036854775808.0))
+			return std::numeric_limits<int64_t>::min();
+		return static_cast<int64_t>(v);
+	}
+
+	/** GCC's `(unsigned int)float` on x86-64: the 64-bit conversion's low half. */
+	inline uint32_t x86FloatToUint32(float v)
+	{
+		return static_cast<uint32_t>(static_cast<uint64_t>(x86FloatToInt64(v)));
+	}
+}
+
+#endif
