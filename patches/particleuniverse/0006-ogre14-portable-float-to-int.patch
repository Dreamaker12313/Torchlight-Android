 namespace ParticleUniverse
 {
@@ -204,10 +205,20 @@ namespace ParticleUniverse
 			*/
 			inline unsigned int _calculateIndex(const Vector3& position)
 			{
+#if OGRE_VERSION < 0xE0000
 				long x = (long)((floor (position.x / mCellDimension)) * 73856093);
 				long y = (long)((floor (position.y / mCellDimension)) * 19349663);
 				long z = (long)((floor (position.z / mCellDimension)) * 83492791);
 				long i = (x ^ y ^ z) % mTableSize;
+#else
+				// Portable (the OGRE 14 port's targets include AArch64 and 32-bit-long Windows):
+				// `long` is 64 bits on the x86-64 reference, and the conversions out of range are
+				// x86's on every CPU. With a 32-bit long the modulo was also unsigned.
+				int64_t x = x86DoubleToInt64((floor (position.x / mCellDimension)) * 73856093);
+				int64_t y = x86DoubleToInt64((floor (position.y / mCellDimension)) * 19349663);
+				int64_t z = x86DoubleToInt64((floor (position.z / mCellDimension)) * 83492791);
+				int64_t i = (x ^ y ^ z) % (int64_t)mTableSize;
+#endif
 				i = i < 0 ? mTableSize - 1 : i; // If negative, point to the last cell.
 				return static_cast<unsigned int>(i);
 			};
